# --- Public (shipped to the browser) -----------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# "demo" = simulated payment screen, no Razorpay account needed, refunds settle instantly.
# "razorpay" = real Razorpay Checkout (then the Razorpay key id, key secret and webhook secret are required).
NEXT_PUBLIC_PAYMENTS_MODE=demo
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Server only (never prefix with NEXT_PUBLIC_) ------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Razorpay Checkout + webhook signature verification
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX current account used as the source for caddy UPI payouts
RAZORPAYX_ACCOUNT_NUMBER=

# Resend transactional email
# Optional: leave empty to skip emails (logged as skipped).
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp / SMS provider webhooks (optional until Phase 2 notifications)
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
